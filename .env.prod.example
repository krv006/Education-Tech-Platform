# Production .env — serverda `cp .env.prod.example .env` qilib to'ldiring.
DJANGO_ENV=prod
DOMAIN=edu.thesofmebel.uz

# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REAL_SECRET_KEY_SHU_YERGA

ALLOWED_HOSTS=edu.thesofmebel.uz
CSRF_TRUSTED_ORIGINS=https://edu.thesofmebel.uz
CORS_ALLOWED_ORIGINS=https://edu.thesofmebel.uz
TIME_ZONE=Asia/Tashkent

# Postgres
POSTGRES_DB=edtech
POSTGRES_USER=edtech
POSTGRES_PASSWORD=KUCHLI_PAROL_SHU_YERGA

# LiveKit — sekret kamida 32 belgi.
# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_API_KEY=fokus_prod
LIVEKIT_API_SECRET=KAMIDA_32_BELGILIK_SEKRET_SHU_YERGA
# Brauzer clientlari ulanadigan manzil (Caddy /livekit -> livekit:7880 proxy)
LIVEKIT_URL=wss://edu.thesofmebel.uz/livekit
